# Copied to .env by `make up` / `make test` when .env is missing.
# Change the password before you expose the broker anywhere but localhost.
RABBITMQ_USER=orders_app
RABBITMQ_PASSWORD=change-me-before-real-use

# Retry policy. MAX_RETRIES=3 means 1 first attempt + 3 retries = 4 handler calls.
# RETRY_DELAY_MS is baked into the retry queue as x-message-ttl: if you change it
# on an existing broker, run `make reset` (RabbitMQ refuses to redeclare a queue
# with different arguments).
MAX_RETRIES=3
RETRY_DELAY_MS=3000
