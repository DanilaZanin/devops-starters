# Copied to .env by `make up` / `make test` when .env is missing.
# Change the password before you expose Redis anywhere but localhost.
REDIS_PASSWORD=change-me-before-real-use

# Cache behaviour (all optional, these are the defaults).
CACHE_TTL_SECONDS=30
# Simulated latency of the slow data source behind the cache.
SOURCE_LATENCY_S=0.5
# Single-flight lock: how long one loader may hold it, and how long the other
# requests wait. Keep LOCK_WAIT_S (seconds) above LOCK_TTL_MS (milliseconds).
LOCK_TTL_MS=5000
LOCK_WAIT_S=6
