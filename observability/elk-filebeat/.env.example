# Copied to .env by `make up` / `make test` when .env is missing.
# Change all of these before you expose the stack anywhere but localhost.
# Avoid quotes and backslashes in passwords: setup.sh puts them into JSON as-is.
ELASTIC_PASSWORD=change-me-elastic
KIBANA_PASSWORD=change-me-kibana
FILEBEAT_PASSWORD=change-me-filebeat

# Must be at least 32 characters. Kibana uses it to encrypt saved objects and sessions.
KIBANA_ENCRYPTION_KEY=change-me-change-me-change-me-32-chars-min
