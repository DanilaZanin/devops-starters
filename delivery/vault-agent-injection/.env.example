# Copied to .env by `make` if .env does not exist. Dev-mode Vault only:
# this is a throwaway root token for a cluster that lives for a few minutes.
VAULT_DEV_ROOT_TOKEN=dev-only-root-token
# Chart version of hashicorp/vault. Check what exists with:
#   helm search repo hashicorp/vault --versions   (after adding the repo)
VAULT_CHART_VERSION=0.34.1
